{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DropXS3ObjectOperations",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:HeadObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_DROPX_BUCKET_NAME/*"
    },
    {
      "Sid": "DropXS3BucketLocation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_DROPX_BUCKET_NAME"
    }
  ]
}
