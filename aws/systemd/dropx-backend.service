[Unit]
Description=DropX Node.js Backend Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/dropx/backend
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=STORAGE_PROVIDER=local
EnvironmentFile=-/opt/dropx/backend/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3s

# Standard output and error logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dropx-backend

[Install]
WantedBy=multi-user.target
