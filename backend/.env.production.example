# DropX Backend Production Environment Template (Self-Hosted Deployment)
# Save as /opt/dropx/backend/.env on your production server

NODE_ENV=production
PORT=3000

# Storage Provider
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/var/dropx/uploads

# Database Connection (PostgreSQL or SQLite fallback)
DATABASE_URL=postgresql://dropx_admin:CHANGE_ME_IN_PRODUCTION@localhost:5432/dropx_prod
DB_POOL_MAX=10

# Shared Redis Service for Multi-Instance Socket.IO & Shared Rate Limiting (Optional)
REDIS_URL=redis://localhost:6379

# Shared Socket HMAC Signing Secret
SOCKET_TOKEN_SECRET=GENERATE_SECURE_RANDOM_SECRET_KEY_64_CHARS

# Reverse Proxy Trust Configuration (1 hop from Nginx/Caddy)
TRUST_PROXY_HOPS=1

# Temporary Room & Cleanup Configuration
ROOM_TTL_MINUTES=120
ROOM_CLEANUP_INTERVAL_MS=60000
PENDING_FILE_TTL_MINUTES=30

# File & Storage Limits
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_ROOM=20
MAX_ROOM_STORAGE_BYTES=524288000

# Download/Upload Link Expiration
UPLOAD_URL_EXPIRY_SECONDS=300
DOWNLOAD_URL_EXPIRY_SECONDS=300
