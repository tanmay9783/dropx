# DropX Backend Production Environment Template (Phase 10 — HA Deployment)
# Save as /opt/dropx/backend/.env on every EC2 instance

NODE_ENV=production
PORT=3000

# AWS S3 Configuration
# NOTE: Access keys are NOT required when running on EC2 with an attached IAM Instance Role.
AWS_REGION=ap-south-1
S3_BUCKET_NAME=dropx-prod-files-ap-south-1

# Storage Provider (must be set to 's3' for production deployment)
STORAGE_PROVIDER=s3

# Database Connection (RDS PostgreSQL Multi-AZ)
# Format: postgresql://<user>:<password>@<rds-endpoint>:5432/<dbname>?sslmode=require
DATABASE_URL=postgresql://dropx_admin:CHANGE_ME_IN_PRODUCTION@dropx-db.c123456789.ap-south-1.rds.amazonaws.com:5432/dropx_prod?sslmode=require
DB_POOL_MAX=10

# Shared Redis/Valkey Service for Multi-Instance Socket.IO, Presence & Shared Rate Limiting
# Format: redis://:<password>@<redis-cluster-endpoint>:6379/0
REDIS_URL=redis://dropx-redis.c123456789.ap-south-1.cache.amazonaws.com:6379

# Shared Socket HMAC Signing Secret (MUST be identical across all EC2 nodes)
SOCKET_TOKEN_SECRET=GENERATE_SECURE_RANDOM_SECRET_KEY_64_CHARS

# Reverse Proxy Trust Configuration (1 hop from ALB + Nginx)
TRUST_PROXY_HOPS=1

# Temporary Room & Cleanup Configuration
ROOM_TTL_MINUTES=120
ROOM_CLEANUP_INTERVAL_MS=60000
PENDING_FILE_TTL_MINUTES=30

# File & Storage Limits
MAX_FILE_SIZE_BYTES=104857600
MAX_FILES_PER_ROOM=20
MAX_ROOM_STORAGE_BYTES=524288000

# Presigned URL Expiration
UPLOAD_URL_EXPIRY_SECONDS=300
DOWNLOAD_URL_EXPIRY_SECONDS=300
